[Unit]
Description=Analyst Buddy
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__APP__
ExecStart=__APP__/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
